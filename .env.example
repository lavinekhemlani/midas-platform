# ── Minimum to boot locally (no AWS needed) ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
AWS_REGION=us-east-1
AWS_S3_REGION=us-east-1
NEXT_PUBLIC_COGNITO_REGION=us-east-1
CHAT_HISTORY_TABLE=midas-chat-history
CHAT_TABLE_NAME=midas-chat
NODE_ENV=development

# ── AWS (section 3 of RESTART.md) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=
S3_UPLOADS_BUCKET_NAME=
S3_DECKS_BUCKET_NAME=
INITIAL_SYNC_LAMBDA_NAME=

# ── DynamoDB: 13 tables, names are yours to choose ──
USERS_TABLE_NAME=
ORGANIZATIONS_TABLE_NAME=
AI_MEMORIES_TABLE=
AI_ANALYSIS_TABLE_NAME=
REPORTS_TABLE_NAME=
TOKEN_USAGE_TABLE=
BC_CREDENTIALS_TABLE_NAME=
SHOPIFY_CREDENTIALS_TABLE_NAME=
SUPPORT_TICKETS_TABLE_NAME=
TERMS_TABLE_NAME=
DYNAMODB_LOCK_TABLE=

# ── QuickBooks (start here — primary integration) ──
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID_PROD=
QUICKBOOKS_CLIENT_SECRET_PROD=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=
QUICKBOOKS_USE_PROXY=false
QUICKBOOKS_PROXY_URL=
QUICKBOOKS_ALLOW_SELF_SIGNED=false

# ── Other providers (optional at first) ──
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SHOP_DOMAIN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_DOMAIN=
ZOHO_CALLBACK_PATH=
BC_AZURE_CLIENT_ID=
BC_AZURE_CLIENT_SECRET=

# ── Redshift: only needed for Dynamics 365. Skip if deferring. ──
REDSHIFT_WORKGROUP_NAME=
REDSHIFT_DATABASE=
REDSHIFT_DB_USER=

# ── AI + data ──
GROQ_API_KEY=
TAVILY_API_KEY=
DATABASE_URL=

# ── Ops (optional) ──
SLACK_WEBHOOK_URL=
MONITORING_WEBHOOK_URL=
SECURITY_WEBHOOK_URL=
LOG_LEVEL=info
DEBUG_AI_CHAT=false
