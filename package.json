  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "node -e \"try { process.env.NODE_ENV !== 'production' && require('child_process').execSync('simple-git-hooks', {stdio: 'inherit'}) } catch (e) {}\"",
    "seed:learn": "node scripts/seed-learn-data.js",
    "create:learn-tables": "node scripts/create-learn-tables.js",
    "setup:learn": "npm run create:learn-tables && npm run seed:learn"
  },
