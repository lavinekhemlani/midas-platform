    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "bash -c 'eslint --fix \"$@\" || true' --"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
